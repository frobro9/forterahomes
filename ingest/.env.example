# Where forterahomes is deployed and the shared secret for its
# ingest-key-authenticated pipeline endpoints (functions/api/property-finder/
# ingest.js and pipeline/*). Set as GitHub Actions secrets in production,
# not this file.
PROPERTY_FINDER_BASE_URL=https://forterahomes.pages.dev
PROPERTY_FINDER_INGEST_KEY=

# Set to "true" to resolve zoning from the City of Ottawa's live GIS
# services instead of a listing's manually supplied zoneCode. Off by
# default so CSV-driven dev/test runs stay network-free.
USE_LIVE_GIS=false

# Listings source: "csv" (default, data/sample-listings.csv) or "email"
# (reads a mailbox fed by a realtor's MLS spec-sheet auto-email — see
# lib/providers/emailProvider.ts).
LISTINGS_PROVIDER=csv

# Only used when LISTINGS_PROVIDER=email. Use a dedicated mailbox and an
# app-specific password (e.g. Gmail: Account > Security > App Passwords),
# never your real account password. This can point at the same mailbox
# mls-scraper reads (IMAP search-by-date is read-only and non-destructive,
# so independent pollers don't interfere with each other) or a separate one.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
# Optional: only process emails from this address (the realtor's forwarder).
EMAIL_FROM_FILTER=

# forterahomes' OWN Anthropic API key — independent of mls-scraper's, used
# by lib/providers/oneHomeExtractor.ts for the same listing-field extraction.
ANTHROPIC_API_KEY=
