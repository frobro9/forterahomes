{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fortera-homes",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd /tmp/fortera-site && python3 -m http.server $PORT"],
      "port": 4200,
      "autoPort": true
    },
    {
      "name": "fortera-admin-portal",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "pages", "dev", ".", "--port", "$PORT"],
      "port": 8788,
      "autoPort": true
    }
  ]
}
